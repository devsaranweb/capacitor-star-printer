{
  "name": "@aybinv7/capacitor-star-printer",
  "version": "0.1.0",
  "description": "Minimal Capacitor plugin for Star Micronics printers via the official StarXpand SDK (StarIO10). Bluetooth Classic SPP (Android) + MFi/iAP2 (iOS) transport for TSP100III/TSP650II/mC-Print and other StarPRNT printers.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "CapacitorStarPrinter.podspec",
    "Package.swift"
  ],
  "author": "devsaranweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsaranweb/capacitor-star-printer.git"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "star",
    "starmicronics",
    "stario10",
    "starxpand",
    "tsp100",
    "starprnt",
    "bluetooth",
    "thermal",
    "printer",
    "android",
    "ios"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc && rollup -c rollup.config.mjs",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.2",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
